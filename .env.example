# Copy to .env for local use; set the same names in Vercel (Project > Settings > Environment Variables).

# Shopify store's permanent domain (no https://).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Storefront API PUBLIC access token (Headless sales channel). Never use the private token here.
SHOPIFY_STOREFRONT_TOKEN=
# Monthly selling plan GID from the Shopify Subscriptions app. Checkout refuses orders without it.
SHOPIFY_SELLING_PLAN_ID=gid://shopify/SellingPlan/0
# Optional: branded checkout host (e.g. checkout.ruffora.shop), swapped into the checkout URL.
SHOPIFY_CHECKOUT_HOST=
# Optional: Meta pixel ID. Leave blank until a Meta account exists (pixel stays disabled).
META_PIXEL_ID=
# Optional: PORT for `npm run dev` (default 8080).
PORT=
